# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Dataset images (large, licence "Unknown", may contain residual patient info).
# Folder skeleton is kept; everything is regenerated by
#   scripts/download_dataset.py -> scripts/prepare_dataset.py
dataset/raw/*
dataset/processed/*
dataset/train/
dataset/validation/
dataset/test/
!dataset/**/.gitkeep
# Small, name-free metadata is versioned so the exact split is reproducible/auditable.
!dataset/metadata/

# Trained models and checkpoints (large binaries) — keep only the folder skeleton
models/**
!models/**/
!models/**/.gitkeep
*.keras
*.h5

# Generated reports, logs, TensorBoard runs
# (data_analysis/ is small and pseudonymised — versioned as Phase 2 evidence)
reports/*
!reports/.gitkeep
!reports/data_analysis/
# architecture summaries + sanity-check report (small text)
!reports/model/
logs/

# Environment files / secrets (none are required by this project)
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
.idea/
!.vscode/settings.json

# Streamlit secrets
.streamlit/secrets.toml
